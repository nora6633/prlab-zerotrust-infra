#!/usr/bin/env python3
"""Inject DDoS Active Response config into Wazuh manager ossec.conf (idempotent).
Targets the host-side bind-mounted file — changes to the in-container ossec.conf
are wiped on every container restart by the entrypoint.

Per ddos-plan.txt Part 3: neither <active-response> block below has a <rules_id>
or <level>, so Wazuh will NEVER dispatch them automatically off an alert match.
They exist purely so Shuffle can call PUT /active-response (see
roles/shuffle/templates/wazuh_ddos_workflow.json.j2) after the N5 scoring node
decides AUTO_BLOCK. This also sidesteps the wazuh-execd auto-dispatch flakiness
documented in README.md for the old rule-bound bindings.

Two commands (not one) because the executable Wazuh looks for lives on the
AGENT's own disk and differs by OS — dmz-windows needs ip-limit.cmd (netsh),
dmz-ubuntu needs ip-limit.sh (iptables). Shuffle picks the right command name
per-alert based on agent name (see ddos_score_alert.py's ar_command field)."""
import re
import sys

OSSEC_CONF = "{{ wazuh_manager_host_conf }}"
START = "<!-- BEGIN: prlab-ddos-active-response -->"
END   = "<!-- END: prlab-ddos-active-response -->"

block = f"""
{START}
  <command>
    <name>ip-limit-windows</name>
    <executable>ip-limit.cmd</executable>
    <expect>srcip</expect>
    <timeout_allowed>yes</timeout_allowed>
  </command>

  <command>
    <name>ip-limit-linux</name>
    <executable>ip-limit.sh</executable>
    <expect>srcip</expect>
    <timeout_allowed>yes</timeout_allowed>
  </command>

  <!-- No rules_id / level: manual/API dispatch only, never automatic. -->
  <active-response>
    <disabled>no</disabled>
    <command>ip-limit-windows</command>
    <location>all</location>
    <timeout>300</timeout>
  </active-response>

  <active-response>
    <disabled>no</disabled>
    <command>ip-limit-linux</command>
    <location>all</location>
    <timeout>300</timeout>
  </active-response>
{END}
""".strip()

with open(OSSEC_CONF, "r") as f:
    content = f.read()

# Remove any prior block(s) — handles duplicates from earlier buggy runs, and
# lets this script also clean up the older rule-bound nginx-ratelimit/
# firewall-block bindings from a previous version of this template.
content = re.sub(
    re.escape(START) + r".*?" + re.escape(END) + r"\s*",
    "",
    content,
    flags=re.DOTALL,
)

# Insert exactly once before the FIRST </ossec_config> (the main config block;
# ossec.conf often has a second block dedicated to active-responses.log).
content = content.replace("</ossec_config>", f"{block}\n</ossec_config>", 1)

with open(OSSEC_CONF, "w") as f:
    f.write(content)

print("OK")
