<!-- DDoS HTTP flood + Slowloris detection on the nginx reverse proxy in front of
     Juice Shop. Rule chain design follows ddos-plan.txt Parts 1-2, adapted to
     this lab's actual Wazuh 4.9.2 ruleset:

       - The plan's example chains off built-in rule 31103. In THIS ruleset
         31103 is "SQL injection attempt" (see 0245-web_rules.xml), not a
         generic access-log tag. The rule that actually fires for a plain
         GET/HEAD flood is 31108 "Ignored URLs (simple queries)" - verified
         empirically with wrk (see git history) and kept here for that reason.
       - The plan's Slowloris rule filters on a field named "http_status".
         The web-accesslog decoder in this ruleset names that field "id"
         (see <order>srcip, protocol, url, id</order> in
         0375-web-accesslog_decoders.xml) - confirmed with wazuh-logtest.
         31108 itself only matches 2xx/3xx (<id>^2|^3</id>), so the Slowloris
         branch cannot hang off it; it chains off 31101 (built-in "Web server
         400 error code") instead, which already narrows to 4xx.
       - 100200/100210/100213 only ever see 2xx/3xx (via 31108), and
         100211/100212 only ever see exactly 408. A flood that makes nginx
         answer with a plain 400/401/403/404/429/etc. matched neither chain -
         it only fired the bare built-in 31101 (level 5) once per request,
         with no aggregation and no forwarding to Shuffle. 100220/100221/
         100222 close that gap: same shape as 100200/100210/100213, but
         chains off 31101 directly and excludes 408 via negate="yes" so the
         same log line never double-alerts on both this branch and the
         Slowloris one. negate="yes" is a confirmed, live attribute in this
         Wazuh 4.9.2 ruleset on <field name="..."> elements (see built-in
         0017-wazuh-api_rules.xml); confirmed it also works on <id> via
         wazuh-logtest: a synthetic 404 line lands on 100220 only, a
         synthetic 408 line lands on 100211 only, no overlap either way.

     Detection produces alerts only - no <active-response> is bound to any
     rule here. Blocking happens exclusively via Shuffle calling Wazuh's
     Active Response API after scoring (see inject_active_response.py.j2 and
     roles/shuffle/files/ddos_score_alert.py) so a mis-scored legitimate user
     is never blocked by reflex. -->
<group name="ddos,web_attack,juiceshop,">

  <!-- ============================================================
       100200: base tagging rule - fires once PER request (2xx/3xx only)
       Promotes 31108 (level 0, doesn't count towards frequency) to a
       level so the frequency rules below can count it.
       ============================================================ -->
  <rule id="100200" level="1">
    <if_sid>31108</if_sid>
    <description>Nginx: web access (counted for HTTP flood detection)</description>
    <group>web,accesslog,</group>
  </rule>

  <!-- ============================================================
       100210: traffic spike - 100 hits of 100200 from the SAME IP in 10s
       "Watch" tier - this is the sid forwarded to Shuffle (ddos-plan.txt's
       300011). Not bound to any active-response: Shuffle decides.
       ============================================================ -->
  <rule id="100210" level="8" frequency="100" timeframe="10">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>Nginx: HTTP rate spike from $(srcip): 100 reqs in 10s</description>
    <mitre><id>T1499.002</id></mitre>
    <group>ddos,http_flood,attack,</group>
  </rule>

  <!-- ============================================================
       100211: base tag for HTTP 408 (client timeout) responses.
       Independent of 100200 - Slowloris connections never complete a
       request, so nginx logs them as 408, not 2xx/3xx. Chains off the
       built-in 31101 (400-class errors) and narrows to 408 specifically.
       ============================================================ -->
  <rule id="100211" level="1">
    <if_sid>31101</if_sid>
    <id>^408$</id>
    <description>Nginx: HTTP 408 (client timeout) - counted for Slowloris detection</description>
    <group>web,accesslog,</group>
  </rule>

  <!-- ============================================================
       100212: Slowloris - 50 HTTP 408s from the SAME IP in 30s
       Independent branch (not part of the 100210->100213 chain).
       Forwarded to Shuffle alongside 100210/100213.
       ============================================================ -->
  <rule id="100212" level="10" frequency="50" timeframe="30">
    <if_matched_sid>100211</if_matched_sid>
    <same_source_ip />
    <description>Nginx: Slowloris attack from $(srcip): 50x HTTP 408 in 30s</description>
    <mitre><id>T1499.002</id></mitre>
    <group>ddos,slowloris,attack,</group>
  </rule>

  <!-- ============================================================
       100213: confirmed DDoS - 50 hits of 100210 from the SAME IP in 30s
       100210 already means "100 reqs/10s"; fifty of those windows in 30s
       is ~5000 reqs/30s from one IP. Level 12 = confirmed, escalate.
       ============================================================ -->
  <rule id="100213" level="12" frequency="50" timeframe="30">
    <if_matched_sid>100210</if_matched_sid>
    <same_source_ip />
    <description>Nginx: Confirmed DDoS from $(srcip) - SOAR escalation</description>
    <mitre><id>T1499.002</id><id>T1498</id></mitre>
    <group>ddos,http_flood,attack,high_severity,</group>
  </rule>

  <!-- ============================================================
       100220: base tagging rule - fires once PER request for ANY 4xx
       EXCEPT 408 (400, 401, 403, 404, 429, etc). 408 is excluded via
       negate so a Slowloris connection's 408 never double-alerts on
       both this branch and 100211/100212.
       ============================================================ -->
  <rule id="100220" level="1">
    <if_sid>31101</if_sid>
    <id negate="yes">^408$</id>
    <description>Nginx: generic 4xx client error, excluding 408 (counted for HTTP error-flood detection; 408/Slowloris has its own dedicated 100211/100212 branch)</description>
    <group>web,accesslog,</group>
  </rule>

  <!-- ============================================================
       100221: error-flood spike - 100 hits of 100220 from the SAME IP
       in 10s. "Watch" tier, mirrors 100210's shape. Forwarded to
       Shuffle.
       ============================================================ -->
  <rule id="100221" level="8" frequency="100" timeframe="10">
    <if_matched_sid>100220</if_matched_sid>
    <same_source_ip />
    <description>Nginx: HTTP 4xx error-response rate spike from $(srcip): 100 4xx in 10s</description>
    <mitre><id>T1499.002</id></mitre>
    <group>ddos,http_flood,error_flood,attack,</group>
  </rule>

  <!-- ============================================================
       100222: confirmed 4xx error-flood DDoS - 50 hits of 100221 from
       the SAME IP in 30s. Mirrors 100213's shape and thresholds.
       Level 12 = confirmed, escalate; forwarded to Shuffle.
       ============================================================ -->
  <rule id="100222" level="12" frequency="50" timeframe="30">
    <if_matched_sid>100221</if_matched_sid>
    <same_source_ip />
    <description>Nginx: Confirmed 4xx error-flood DDoS from $(srcip) - SOAR escalation</description>
    <mitre><id>T1499.002</id><id>T1498</id></mitre>
    <group>ddos,http_flood,error_flood,attack,high_severity,</group>
  </rule>

  <!-- ============================================================
       100230: base tagging rule - fires once PER request for 5xx server
       errors. Chains off the built-in 31120 ("Web server 500 error code"),
       which itself chains off 31100 filtered to id ^50 - a sibling of
       31101 (^40x), not a descendant, so no overlap/negate needed here.

       Added after live testing showed a heavy enough flood can push the
       Juice Shop backend itself into failure (nginx logs "recv() failed
       (104: Connection reset by peer)" reading from the upstream) and
       start answering with 500s instead of 2xx/3xx/4xx. Rules 100200/
       100211/100220 only ever see 31108 or 31101 - neither matches 31120
       - so that failure mode previously produced ZERO forwarded alerts:
       traffic heavy enough to actually crash the backend was invisible
       to detection, the one case where "the DDoS worked" and Wazuh had
       nothing to say about it.
       ============================================================ -->
  <rule id="100230" level="1">
    <if_sid>31120</if_sid>
    <description>Nginx: HTTP 5xx server error (counted for HTTP error-flood detection)</description>
    <group>web,accesslog,</group>
  </rule>

  <!-- ============================================================
       100231: 5xx error-flood spike - 100 hits of 100230 from the SAME IP
       in 10s. "Watch" tier, mirrors 100210/100221's shape. Forwarded to
       Shuffle.
       ============================================================ -->
  <rule id="100231" level="8" frequency="100" timeframe="10">
    <if_matched_sid>100230</if_matched_sid>
    <same_source_ip />
    <description>Nginx: HTTP 5xx error-response rate spike from $(srcip): 100 5xx in 10s</description>
    <mitre><id>T1499.002</id></mitre>
    <group>ddos,http_flood,error_flood,attack,</group>
  </rule>

  <!-- ============================================================
       100232: confirmed 5xx error-flood DDoS - 50 hits of 100231 from
       the SAME IP in 30s. Mirrors 100213/100222's shape and thresholds.
       Level 12 = confirmed, escalate; forwarded to Shuffle.
       ============================================================ -->
  <rule id="100232" level="12" frequency="50" timeframe="30">
    <if_matched_sid>100231</if_matched_sid>
    <same_source_ip />
    <description>Nginx: Confirmed 5xx error-flood DDoS from $(srcip) - SOAR escalation</description>
    <mitre><id>T1499.002</id><id>T1498</id></mitre>
    <group>ddos,http_flood,error_flood,attack,high_severity,</group>
  </rule>

</group>
