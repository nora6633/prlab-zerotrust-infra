{
  "id": "{{ shuffle_ddos_workflow_id }}",
  "name": "Wazuh DDoS Auto-Response",
  "description": "8-node SOAR workflow: filter L>=10 alerts, enrich with AbuseIPDB + Wazuh history, score (5 dimensions), then AUTO_BLOCK via PA / NOTIFY_SOC / LOG_ONLY based on confidence score. MTTR recorded to DFIR-IRIS.",
  "tags": ["wazuh", "ddos", "pa", "soar", "abuseipdb"],
  "status": "running",
  "workflow_variables": [],
  "actions": [

    {
      "id": "abuseipdb_query",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "GET",
      "label": "abuseipdb_query",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "https://api.abuseipdb.com/api/v2/check?ipAddress=$exec.data.srcip&maxAgeInDays=90"
        },
        {
          "name": "headers",
          "value": "Key: {{ abuseipdb_api_key }}\r\nAccept: application/json"
        },
        {
          "name": "verify",
          "value": "true"
        }
      ],
      "position": {"x": 300, "y": 150}
    },

    {
      "id": "wazuh_history",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "POST",
      "label": "wazuh_history",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "{{ wazuh_indexer_url }}/wazuh-alerts-*/_search"
        },
        {
          "name": "headers",
          "value": "Content-Type: application/json\r\nAuthorization: Basic {{ (wazuh_indexer_user + ':' + wazuh_indexer_password) | b64encode }}"
        },
        {
          "name": "body",
          "value": "{\"size\":0,\"query\":{\"bool\":{\"filter\":[{\"term\":{\"data.srcip\":\"$exec.data.srcip\"}},{\"range\":{\"@timestamp\":{\"gte\":\"now-24h\"}}}]}}}"
        },
        {
          "name": "verify",
          "value": "false"
        }
      ],
      "position": {"x": 300, "y": 350}
    },

    {
      "id": "score_alert",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "app_id": "shuffle-tools",
      "name": "execute_python",
      "label": "score_alert",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "code",
          "value": {{ score_alert_code | to_json }}
        }
      ],
      "position": {"x": 600, "y": 250}
    },

    {
      "id": "pa_create_address",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "POST",
      "label": "pa_create_address",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "https://{{ pa_firewall_ip }}/restapi/v10.2/Objects/Addresses?location=vsys&vsys={{ pa_vsys }}&name=SOAR_ADDR_$score_alert.srcip_safe"
        },
        {
          "name": "headers",
          "value": "X-PAN-KEY: {{ pa_api_key }}\r\nContent-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"entry\":[{\"@name\":\"SOAR_ADDR_$score_alert.srcip_safe\",\"ip-netmask\":\"$score_alert.srcip/32\",\"description\":\"Auto-blocked by Shuffle workflow (score $score_alert.score)\"}]}"
        },
        {
          "name": "verify",
          "value": "false"
        }
      ],
      "position": {"x": 900, "y": 100}
    },

    {
      "id": "pa_create_rule",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "POST",
      "label": "pa_create_rule",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "https://{{ pa_firewall_ip }}/restapi/v10.2/Policies/SecurityRules?location=vsys&vsys={{ pa_vsys }}&name=SOAR_BLOCK_$score_alert.ts_safe"
        },
        {
          "name": "headers",
          "value": "X-PAN-KEY: {{ pa_api_key }}\r\nContent-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"entry\":[{\"@name\":\"SOAR_BLOCK_$score_alert.ts_safe\",\"from\":{\"member\":[\"{{ pa_dmz_zone }}\"]},\"to\":{\"member\":[\"{{ pa_dmz_zone }}\"]},\"source\":{\"member\":[\"SOAR_ADDR_$score_alert.srcip_safe\"]},\"destination\":{\"member\":[\"any\"]},\"service\":{\"member\":[\"any\"]},\"application\":{\"member\":[\"any\"]},\"action\":\"deny\",\"log-end\":\"yes\",\"description\":\"Auto-block from Wazuh rule $score_alert.rule_level (score $score_alert.score)\"}]}"
        },
        {
          "name": "verify",
          "value": "false"
        }
      ],
      "position": {"x": 900, "y": 250}
    },

    {
      "id": "pa_commit",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "POST",
      "label": "pa_commit",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "https://{{ pa_firewall_ip }}/api/?type=commit&cmd=<commit></commit>&key={{ pa_api_key }}"
        },
        {
          "name": "verify",
          "value": "false"
        }
      ],
      "position": {"x": 900, "y": 400}
    },

    {
      "id": "notify_soc",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "POST",
      "label": "notify_soc",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "https://{{ wazuh_server_ip }}:4444/api/v1/alerts/add"
        },
        {
          "name": "headers",
          "value": "Authorization: Bearer {{ iris_adm_api_key }}\r\nContent-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"alert_title\":\"NOTIFY_SOC: $score_alert.srcip (score $score_alert.score)\",\"alert_description\":\"Manual triage required.\\nEvidence:\\n$score_alert.evidence_md\",\"alert_severity_id\":4,\"alert_status_id\":2,\"alert_customer_id\":1,\"alert_classification_id\":1,\"alert_source\":\"Wazuh\",\"alert_source_ref\":\"$exec.id\",\"alert_source_link\":\"https://{{ wazuh_server_ip }}\",\"alert_source_event_time\":\"$exec.timestamp\"}"
        },
        {
          "name": "verify",
          "value": "false"
        }
      ],
      "position": {"x": 900, "y": 600}
    },

    {
      "id": "iris_record_mttr",
      "app_name": "HTTP",
      "app_version": "1.3.0",
      "app_id": "http",
      "name": "POST",
      "label": "iris_record_mttr",
      "environment": "Shuffle",
      "is_valid": true,
      "parameters": [
        {
          "name": "url",
          "value": "https://{{ wazuh_server_ip }}:4444/api/v1/cases/add"
        },
        {
          "name": "headers",
          "value": "Authorization: Bearer {{ iris_adm_api_key }}\r\nContent-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"case_name\":\"DDoS auto-response: $score_alert.action ($score_alert.srcip)\",\"case_description\":\"**Decision**: $score_alert.action (score $score_alert.score)\\n**Source IP**: $score_alert.srcip\\n**Wazuh alert**: rule $score_alert.rule_level, $exec.rule.description\\n**Evidence**:\\n$score_alert.evidence_md\\n**MTTR**: alert at $exec.timestamp -> response queued at $score_alert.ts_iso\",\"case_soc_id\":\"W-$exec.id\",\"case_customer\":1,\"case_classification\":1}"
        },
        {
          "name": "verify",
          "value": "false"
        }
      ],
      "position": {"x": 1200, "y": 400}
    }

  ],
  "triggers": [
    {
      "app_name": "Shuffle Triggers",
      "name": "DDoS Webhook",
      "description": "Receives Wazuh DDoS alerts (rule.id 100210/100211/100212)",
      "id": "{{ shuffle_ddos_webhook_trigger_id }}",
      "type": "WEBHOOK",
      "status": "running",
      "app_version": "1.0.0",
      "parameters": [
        {
          "name": "info",
          "value": "Receives Wazuh alerts via HTTP POST. Wazuh integration filters to level >= 10."
        }
      ],
      "position": {"x": 50, "y": 250}
    }
  ],
  "branches": [

    {
      "id": "br-trigger-to-abuse",
      "source_id": "{{ shuffle_ddos_webhook_trigger_id }}",
      "destination_id": "abuseipdb_query",
      "label": "N2: rule.level >= 10",
      "conditions": [
        {
          "source": {"name": "level_filter", "value": "$exec.rule.level"},
          "destination": {"value": "10"},
          "condition": {"value": "larger than or equal"}
        }
      ]
    },
    {
      "id": "br-trigger-to-history",
      "source_id": "{{ shuffle_ddos_webhook_trigger_id }}",
      "destination_id": "wazuh_history",
      "label": "N2: rule.level >= 10 (parallel)",
      "conditions": [
        {
          "source": {"name": "level_filter", "value": "$exec.rule.level"},
          "destination": {"value": "10"},
          "condition": {"value": "larger than or equal"}
        }
      ]
    },

    {
      "id": "br-abuse-to-score",
      "source_id": "abuseipdb_query",
      "destination_id": "score_alert",
      "label": ""
    },
    {
      "id": "br-history-to-score",
      "source_id": "wazuh_history",
      "destination_id": "score_alert",
      "label": ""
    },

    {
      "id": "br-score-to-pa-addr",
      "source_id": "score_alert",
      "destination_id": "pa_create_address",
      "label": "AUTO_BLOCK (score >= 70)",
      "conditions": [
        {
          "source": {"name": "score", "value": "$score_alert.score"},
          "destination": {"value": "70"},
          "condition": {"value": "larger than or equal"}
        }
      ]
    },
    {
      "id": "br-pa-addr-to-pa-rule",
      "source_id": "pa_create_address",
      "destination_id": "pa_create_rule",
      "label": ""
    },
    {
      "id": "br-pa-rule-to-pa-commit",
      "source_id": "pa_create_rule",
      "destination_id": "pa_commit",
      "label": ""
    },
    {
      "id": "br-pa-commit-to-iris",
      "source_id": "pa_commit",
      "destination_id": "iris_record_mttr",
      "label": ""
    },

    {
      "id": "br-score-to-notify",
      "source_id": "score_alert",
      "destination_id": "notify_soc",
      "label": "NOTIFY_SOC (40 <= score < 70)",
      "conditions": [
        {
          "source": {"name": "score", "value": "$score_alert.score"},
          "destination": {"value": "40"},
          "condition": {"value": "larger than or equal"}
        },
        {
          "source": {"name": "score", "value": "$score_alert.score"},
          "destination": {"value": "70"},
          "condition": {"value": "less than"}
        }
      ]
    },
    {
      "id": "br-notify-to-iris",
      "source_id": "notify_soc",
      "destination_id": "iris_record_mttr",
      "label": ""
    },

    {
      "id": "br-score-to-iris-log",
      "source_id": "score_alert",
      "destination_id": "iris_record_mttr",
      "label": "LOG_ONLY (score < 40)",
      "conditions": [
        {
          "source": {"name": "score", "value": "$score_alert.score"},
          "destination": {"value": "40"},
          "condition": {"value": "less than"}
        }
      ]
    }

  ]
}
