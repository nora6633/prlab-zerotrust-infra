#!/usr/bin/env python3
"""Inject insider-threat Active Response config into Wazuh manager ossec.conf
(idempotent). Targets the host-side bind-mounted file - changes to the
in-container ossec.conf are wiped on every container restart by the
entrypoint (same reasoning as wazuh_ddos_rules / wazuh_usb_dlp_rules).

No <rules_id> / <level> on the <active-response> block below, so Wazuh will
NEVER dispatch it automatically off an alert match - only Shuffle's
score_alert node calling PUT /active-response (AUTO_BLOCK, score >= 80)
triggers it. Expect Wazuh to register this as "host-isolate0" (no
<timeout> element -> suffix "0"), same pattern confirmed live for the USB
DLP and DDoS AR commands - verify the actual registered name against
/var/ossec/etc/shared/ar.conf (or a direct API dispatch test) before wiring
the Shuffle workflow node, don't assume the suffix blindly.
"""
import re
import sys

OSSEC_CONF = "{{ wazuh_manager_host_conf }}"
START = "<!-- BEGIN: prlab-insider-threat-active-response -->"
END = "<!-- END: prlab-insider-threat-active-response -->"

block = f"""
{START}
  <command>
    <name>host-isolate</name>
    <executable>host-isolate.sh</executable>
    <timeout_allowed>yes</timeout_allowed>
  </command>

  <!-- No rules_id / level: manual/API dispatch only, never automatic. -->
  <active-response>
    <disabled>no</disabled>
    <command>host-isolate</command>
    <location>all</location>
  </active-response>
{END}
""".strip()

with open(OSSEC_CONF, "r") as f:
    content = f.read()

content = re.sub(
    re.escape(START) + r".*?" + re.escape(END) + r"\s*",
    "",
    content,
    flags=re.DOTALL,
)

content = content.replace("</ossec_config>", f"{block}\n</ossec_config>", 1)

with open(OSSEC_CONF, "w") as f:
    f.write(content)

print("OK")
