#!/usr/bin/env python3
"""
Wazuh custom integration: forward alerts to Shuffle SOAR webhook(s).

Placed at /var/ossec/integrations/custom-shuffle in the manager container.
Wazuh's integratord invokes it as:
    custom-shuffle <alert_file> <api_key> <hook_url>
We ignore positional args and use the URLs baked in at deploy time.

Posts to three webhooks with different filters:
  1. IRIS-case workflow (legacy) — every alert (level >= integration <level>)
     keeps existing case automation working for all of SOC, not just DDoS.
  2. DDoS auto-response workflow — ONLY rule IDs 100210/100212/100213, the
     generic 4xx error-flood branch 100221/100222, and the 5xx error-flood
     branch 100231/100232 (ddos-plan.txt Part 2: forward from the "watch"
     tier upward, never a per-request base tag (100200/100211/100220/
     100230) — those fire once per HTTP request and would flood Shuffle/
     AbuseIPDB with noise for zero decision value).
  3. USB-DLP auto-response workflow — rule 100500 (file written to the
     simulated removable disk), see roles/wazuh_usb_dlp_rules. Unlike the
     DDoS rules, 100500 is NOT a frequency rule — it fires once per real
     file write, not once per matching event above a threshold — so every
     occurrence is forwarded. Shuffle's own scoring (usb_dlp_score_alert.py)
     needs every single event to compute its 10-minute same-endpoint
     history dimension; debouncing here would silently undercount it.

Failure on one webhook does not block the others.

Debounced per (srcip, rule_id), not per srcip alone: a real flood makes a
single frequency rule (e.g. 100210) re-fire on every matching event once
its threshold is crossed — hundreds/thousands of times over a 30s flood —
and integratord spawns this script fresh for EACH one, so forwarding all
of them fires hundreds of near-simultaneous webhook POSTs. Confirmed live
this saturates Shuffle's webhook-to-startnode resolution (self-hosted,
OpenSearch-backed): under that burst, EVERY hook — both the DDoS one and
the unrelated IRIS one — started logging "No start node for hook ...
running with workflow default" (1000+ times in 3 minutes from one flood)
and silently skipped running the actual workflow DAG, so no Active
Response call was ever made despite Wazuh detecting the attack correctly.

Keying debounce on srcip ALONE (first version of this fix) backfired: the
noisy "watch" tier (100210, firing hundreds of times) won every debounce
window for that srcip, so the much-rarer but decision-critical escalation
alerts (100213/100222/100232) got silently starved out entirely — Wazuh
fired them correctly but they never reached Shuffle. Keying on (srcip,
rule_id) instead gives each distinct rule its own independent debounce
clock, so 100210's noise can't crowd out 100213 forwarding on schedule.
Alerts with no srcip (non-DDoS SOC alerts from FreeIPA/Nextcloud/Mailcow
etc, which aren't floods) are never debounced, since keying on an empty
string would cross-suppress unrelated alert types. FIM alerts (rule 100500)
have no data.srcip at all, so this same "empty srcip = never debounced"
path is exactly what lets every 100500 event through unthrottled too.
"""
import json
import os
import sys
import time
import urllib.request
import urllib.error

IRIS_WEBHOOK_URL = "http://{{ wazuh_server_ip }}:5001/api/v1/hooks/webhook_{{ shuffle_webhook_trigger_id }}"
DDOS_WEBHOOK_URL = "http://{{ wazuh_server_ip }}:5001/api/v1/hooks/webhook_{{ shuffle_ddos_webhook_trigger_id }}"
USB_DLP_WEBHOOK_URL = "http://{{ wazuh_server_ip }}:5001/api/v1/hooks/webhook_{{ shuffle_usb_dlp_webhook_trigger_id }}"
SHUFFLE_API_KEY = "{{ shuffle_default_apikey }}"

# ddos-plan.txt Part 2: forward the escalation-worthy rules only, not the
# per-request base tags (100200 web-access, 100211 http-408-tag, 100220
# generic-4xx-tag, 100230 generic-5xx-tag). See
# roles/wazuh_ddos_rules/files/local_rules_ddos.xml for the full rule
# chain each of these belongs to.
DDOS_FORWARD_RULE_IDS = {"100210", "100212", "100213", "100221", "100222", "100231", "100232"}

# Every occurrence of 100500 is forwarded (not a frequency rule - see module
# docstring). roles/wazuh_usb_dlp_rules/files/local_rules_usb_dlp.xml.
USB_DLP_FORWARD_RULE_IDS = {"100500"}

DEBOUNCE_SECONDS = 10
DEBOUNCE_DIR = "/tmp/custom-shuffle-debounce"


def should_forward(srcip, rule_id):
    if not srcip:
        return True
    os.makedirs(DEBOUNCE_DIR, exist_ok=True)
    marker = os.path.join(DEBOUNCE_DIR, f"{srcip}_{rule_id}")
    now = time.time()
    try:
        if now - os.path.getmtime(marker) < DEBOUNCE_SECONDS:
            return False
    except FileNotFoundError:
        pass
    open(marker, "w").close()
    return True


def post(url, payload):
    req = urllib.request.Request(
        url,
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {SHUFFLE_API_KEY}",
        },
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=10)
    except urllib.error.URLError as e:
        sys.stderr.write(f"custom-shuffle: {url} -> {e}\n")


def main():
    alert_file_path = sys.argv[1]
    with open(alert_file_path) as f:
        alert = json.load(f)

    srcip = alert.get("data", {}).get("srcip", "")
    rule_id = str(alert.get("rule", {}).get("id", ""))
    if not should_forward(srcip, rule_id):
        return

    payload = json.dumps(alert).encode("utf-8")
    post(IRIS_WEBHOOK_URL, payload)

    if rule_id in DDOS_FORWARD_RULE_IDS:
        post(DDOS_WEBHOOK_URL, payload)

    if rule_id in USB_DLP_FORWARD_RULE_IDS:
        post(USB_DLP_WEBHOOK_URL, payload)


if __name__ == "__main__":
    main()
