# Windows VM runtime state — large binaries / machine-specific
windows-dmz/windows/

# Ubuntu LAN container workspace — runtime data
ubuntu-lan/lan-workspace/
ubuntu-lan/authorized_keys

# dmz-ubuntu container — SSH pubkey is machine-specific
dmz-ubuntu/authorized_keys

# Ansible artifacts
*.retry
__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

# ddos-attacker run_attack.sh state — tracks last-used source IP octet
ddos-attacker/.last_ip_octet
docs/
*.pdf
*.swp

# insider-threat scenario — Ansible-generated SSH test keypair, never commit
secrets/
