# Template for inventory/hosts.ini - copy this file to inventory/hosts.ini
# and fill in real values for your environment. hosts.ini itself is
# gitignored/skip-worktree and must NEVER be committed with real values.
#
# [external] holds the DMZ-facing hosts (Windows victim + Linux victim for
# scenario 3's dmz-ubuntu). [soc] is the single Docker host running every
# container (Wazuh, Shuffle, IRIS...) - ansible_connection=local because
# this playbook set is designed to run FROM that same host. [lan] is the
# internal-network victim host used for lateral-movement steps.

[external]
dmz-windows ansible_host=192.0.2.10 ansible_user=CHANGE_ME ansible_password=CHANGE_ME ansible_connection=winrm ansible_winrm_transport=basic ansible_port=5985 ansible_winrm_server_cert_validation=ignore
dmz-ubuntu ansible_host=192.0.2.20 ansible_user=CHANGE_ME

[soc]
soc-host ansible_host=192.0.2.1 ansible_user=CHANGE_ME ansible_connection=local

[lan]
lan-host ansible_host=192.0.2.30 ansible_user=CHANGE_ME

[all:vars]
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3
